# ===== LLM (OpenRouter) =====
# 백본은 meta-llama/llama-3.3-70b-instruct, provider는 akashml/fp8로 고정한다.
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# ChatAgent.remote_chat()이 POST하는 전체 엔드포인트 (config.py REMOTE_URL)
SURVEYX_REMOTE_URL=https://openrouter.ai/api/v1/chat/completions

# DEFAULT/ADVANCED 모두 동일 백본으로 고정 (원 논문은 gpt-4o-mini / gpt-4o 이원화)
SURVEYX_DEFAULT_MODEL=meta-llama/llama-3.3-70b-instruct
SURVEYX_ADVANCED_MODEL=meta-llama/llama-3.3-70b-instruct

# OpenRouter provider 라우팅 고정: payload에 {"provider": {"only": [...], "allow_fallbacks": false}}
OPENROUTER_PROVIDER_ONLY=akashml/fp8
OPENROUTER_ALLOW_FALLBACKS=false

# LLM HTTP 타임아웃(초). requests 기본은 무한 대기라 행 방지용으로 필요.
SURVEYX_HTTP_TIMEOUT=900

# ===== 디코딩 프로파일 (4 agent 공통 조건 — docs/kisti-run.md §3) =====
# 모두 비우면 원 SurveyX 동작(호출부 temperature 0.5 / outline 0.3, max_tokens 미전송).
# SURVEYX_TEMPERATURE 는 ChatAgent 에서 호출부 값을 덮어쓴다(outline 0.3 포함). temp 0 금지 —
# llama-3.3-70b 가 반복 루프에 빠지고, content_generator 의 markdown 재요청 루프가 무한이 된다.
SURVEYX_TEMPERATURE=0.6
# 출력 잘림 가드. 정상 호출(최장 섹션 rewrite ≈ 3천 단어)에는 걸리지 않는다. 분량 통제가 아니다.
SURVEYX_MAX_TOKENS=8192
# finish_reason=length 응답은 버리고 재요청 (max_tokens 설정 시 기본 true). 소진하면 마지막 응답 채택.
SURVEYX_RETRY_TRUNCATED=true
SURVEYX_MAX_TRUNCATED_RETRY=10

# ===== Embedding =====
# 리콜/필터 임베딩은 로컬 HuggingFace(BAAI/bge-base-en-v1.5)라 API 키 불필요.
# EmbedAgent.remote_embed()를 쓸 일이 생길 때만 채운다.
EMBED_REMOTE_URL=
EMBED_TOKEN=

# ===== Common Corpus (asg-common-corpus) =====
# common_corpus로 설정하면 DataFetcher 대신 CommonCorpusFetcher(로컬 parquet 검색 +
# 전문 지연 확보)를 사용한다. 비우면 원본 DataFetcher(현재 동작 불가).
SURVEYX_DATA_SOURCE=kisti

# 공통 코퍼스 루트와 실험에 사용할 view 이름.
# bench-2512 = 벤치마크 view (cutoff 2025-12-31, GT 25편의 preprint 쌍둥이 15 id 제외).
# 벤치마크 실행 시 반드시 이 값을 쓴다 — 다른 view는 GT 누수가 발생한다.
COMMON_CORPUS_DIR=/data2/chanjoong/survey-agent/asg-common-corpus
COMMON_CORPUS_VERSION=v0.1-poc
COMMON_CORPUS_VIEW=bench-2512
# 전문(md_text) 확보에 쓰는 asg-corpus conda env python (FullTextResolver 실행용)
COMMON_CORPUS_PYTHON=/data2/chanjoong/miniforge3/envs/asg-corpus/bin/python
# 한 번에 전문을 확보할 최대 편수 (0 = 무제한). 스모크 테스트 시 낮춰 쓴다.
COMMON_CORPUS_FULLTEXT_LIMIT=0
# authors / arXiv categories 보강용 로컬 arXiv 스냅샷 (base_id로 조인)
ARXIV_SNAPSHOT_DUCKDB=/data2/chanjoong/survey-agent/survey-search/data/papers.duckdb

# LaTeX 컴파일에 쓸 TeX 배포판 bin 경로 (PATH 앞의 MiKTeX가 불완전하여 TeX Live 지정)
SURVEYX_TEX_BIN=/usr/bin
